{
  "setup": "usdg-issuer",
  "network": {
    "chainId": 42161,
    "name": "Arbitrum One"
  },
  "deploySalt": "usdg-issuer v1",
  "accountSalt": "usdg-issuer v1",
  "token": {
    "contract": "contract/ChainwallStablecoin.sol",
    "constructor": "(string name, string symbol, address registry, address controllerVault)",
    "decimals": 6,
    "defaultName": "Northstar Dollar",
    "defaultSymbol": "NSD",
    "forbiddenNames": [
      "Global Dollar",
      "USDG"
    ],
    "openzeppelin": "v5.3.0",
    "solc": "0.8.36",
    "selectors": {
      "mint": "0x40c10f19",
      "burn": "0x42966c68",
      "freeze": "0x8d1fdf2f",
      "unfreeze": "0x45c8b1a6",
      "wipeFrozenAddress": "0xe2f72f03",
      "balanceOf": "0x70a08231",
      "totalSupply": "0x18160ddd",
      "freezeRevision": "0x086e5b96"
    }
  },
  "catalog": {
    "defaultOrg": "northstar",
    "contractId": "usdg"
  },
  "groups": {
    "usdg-issuance": "mint",
    "usdg-redemption": "burn",
    "usdg-compliance": "freeze",
    "usdg-governance": "unfreeze and wipe, each with a granted authorization",
    "usdg-clients": "addresses allowed to receive a mint"
  },
  "policies": {
    "usdg-issuance-policy": {
      "criteria": [
        "usdg-issuance"
      ],
      "thresholds": [
        1
      ],
      "program": "issuance-policy.ls"
    },
    "usdg-redemption-policy": {
      "criteria": [
        "usdg-redemption"
      ],
      "thresholds": [
        1
      ],
      "program": "redemption-policy.ls"
    },
    "usdg-compliance-policy": {
      "criteria": [
        "usdg-compliance"
      ],
      "thresholds": [
        1
      ],
      "program": "compliance-policy.ls"
    },
    "usdg-governance-policy": {
      "criteria": [
        "usdg-governance"
      ],
      "thresholds": [
        1
      ],
      "program": "governance-policy.ls"
    }
  },
  "interactions": {
    "usdg-mint": {
      "script": "mint.ls",
      "args": [
        "recipient",
        "amount"
      ]
    },
    "usdg-burn": {
      "script": "burn.ls",
      "args": [
        "amount"
      ]
    },
    "usdg-freeze": {
      "script": "freeze.ls",
      "args": [
        "account"
      ]
    },
    "usdg-unfreeze": {
      "script": "unfreeze.ls",
      "args": [
        "account",
        "requestId"
      ]
    },
    "usdg-wipe": {
      "script": "wipe.ls",
      "args": [
        "account",
        "amount",
        "requestId"
      ]
    }
  },
  "policyState": {
    "limitsNamespace": "usdg.limits",
    "supplyCapKey": "usdg.supply-cap",
    "authorizationNamespace": "usdg.authorizations",
    "dailyMeter": "usdg-mint-daily",
    "meterWindowSeconds": 86400,
    "authorizationWindowSeconds": 604800,
    "authorizationKey": "keccak256(abi.encode(bytes32 interactionId, address token, address vault, address account, uint256 amount (0 for unfreeze), uint256 freezeRevision(account), uint256 requestId))"
  },
  "registrySelectors": {
    "getPolicyUint": "0x04ffd4ca",
    "setPolicyUint": "0x21f1e4cb",
    "isGroupMemberByHash": "0xfd7338fb",
    "consumePolicyMeter": "0x4671fe19"
  },
  "defaults": {
    "mintCapBaseUnits": "1000000000000",
    "dailyMintLimitBaseUnits": "5000000000000",
    "supplyCapBaseUnits": "100000000000000"
  },
  "executeCapability": "cap.registry.interaction.execute"
}
